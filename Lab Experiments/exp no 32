#include <stdio.h>
#include <stdlib.h>

#define MAX_FRAMES 3

void printFrames(int frames[], int n)
{
    int i;

    for (i = 0; i < n; i++)
    {
        if (frames[i] == -1)
            printf(" - ");
        else
            printf(" %d ", frames[i]);
    }

    printf("\n");
}

int main()
{
    int frames[MAX_FRAMES];
    int usageHistory[MAX_FRAMES];

    int referenceString[] = {7, 0, 1, 2, 0, 3, 0, 4, 2, 3, 0, 3, 2};

    int n = sizeof(referenceString) / sizeof(referenceString[0]);

    int pageFaults = 0;
    int i, j, k;

    // Initialize frames
    for (i = 0; i < MAX_FRAMES; i++)
    {
        frames[i] = -1;
        usageHistory[i] = 0;
    }

    printf("Reference String: ");

    for (i = 0; i < n; i++)
    {
        printf("%d ", referenceString[i]);
    }

    printf("\n\n");

    printf("Page Replacement Order:\n");

    for (i = 0; i < n; i++)
    {
        int page = referenceString[i];
        int pageFound = 0;

        // Check whether page is already present
        for (j = 0; j < MAX_FRAMES; j++)
        {
            if (frames[j] == page)
            {
                pageFound = 1;

                // Increase usage counter for other pages
                for (k = 0; k < MAX_FRAMES; k++)
                {
                    if (k != j && frames[k] != -1)
                        usageHistory[k]++;
                }

                // Reset usage counter for recently used page
                usageHistory[j] = 0;

                break;
            }
        }

        // Page fault
        if (!pageFound)
        {
            int lruPage = 0;

            printf("Page %d -> ", page);

            // Find empty frame first
            for (j = 0; j < MAX_FRAMES; j++)
            {
                if (frames[j] == -1)
                {
                    lruPage = j;
                    break;
                }
            }

            // If no empty frame, find least recently used page
            if (frames[lruPage] != -1)
            {
                for (j = 1; j < MAX_FRAMES; j++)
                {
                    if (usageHistory[j] > usageHistory[lruPage])
                    {
                        lruPage = j;
                    }
                }
            }

            if (frames[lruPage] == -1)
            {
                printf("Load into an empty frame: ");
            }
            else
            {
                printf("Replace %d with %d: ",
                       frames[lruPage], page);
            }

            frames[lruPage] = page;
            usageHistory[lruPage] = 0;

            printFrames(frames, MAX_FRAMES);

            pageFaults++;
        }
        else
        {
            printf("Page %d -> Page Hit\n", page);
        }
    }

    printf("\nTotal Page Faults: %d\n", pageFaults);

    return 0;
}

