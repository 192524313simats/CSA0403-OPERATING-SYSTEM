#include <stdio.h>
#include <stdlib.h>

#define MAX_FRAMES 3

void printFrames(int frames[], int n)
{
    int i;

    for (i = 0; i < n; i++)
    {
        if (frames[i] == -1)
            printf(" - ");
        else
            printf(" %d ", frames[i]);
    }

    printf("\n");
}

int main()
{
    int frames[MAX_FRAMES];
    int referenceString[] = {7, 0, 1, 2, 0, 3, 0, 4, 2, 3, 0, 3, 2};

    int n = sizeof(referenceString) / sizeof(referenceString[0]);
    int pageFaults = 0;

    int i, j, k;

    // Initialize frames
    for (i = 0; i < MAX_FRAMES; i++)
    {
        frames[i] = -1;
    }

    printf("Reference String: ");

    for (i = 0; i < n; i++)
    {
        printf("%d ", referenceString[i]);
    }

    printf("\n\n");

    printf("Page Replacement Order:\n");

    for (i = 0; i < n; i++)
    {
        int page = referenceString[i];
        int pageFound = 0;

        // Check if page is already present
        for (j = 0; j < MAX_FRAMES; j++)
        {
            if (frames[j] == page)
            {
                pageFound = 1;
                break;
            }
        }

        // Page fault
        if (!pageFound)
        {
            int replaceIndex = -1;
            int farthest = -1;

            printf("Page %d -> ", page);

            // First check for an empty frame
            for (j = 0; j < MAX_FRAMES; j++)
            {
                if (frames[j] == -1)
                {
                    replaceIndex = j;
                    break;
                }
            }

            // If no empty frame, find the page used farthest in future
            if (replaceIndex == -1)
            {
                for (j = 0; j < MAX_FRAMES; j++)
                {
                    int futureDistance = 0;
                    int found = 0;

                    for (k = i + 1; k < n; k++)
                    {
                        if (referenceString[k] == frames[j])
                        {
                            found = 1;
                            break;
                        }

                        futureDistance++;
                    }

                    // If page is never used again, replace it immediately
                    if (!found)
                    {
                        replaceIndex = j;
                        break;
                    }

                    if (futureDistance > farthest)
                    {
                        farthest = futureDistance;
                        replaceIndex = j;
                    }
                }
            }

            if (frames[replaceIndex] == -1)
            {
                printf("Load into empty frame: ");
            }
            else
            {
                printf("Replace %d with %d: ",
                       frames[replaceIndex], page);
            }

            frames[replaceIndex] = page;

            printFrames(frames, MAX_FRAMES);

            pageFaults++;
        }
        else
        {
            printf("Page %d -> Page Hit\n", page);
        }
    }

    printf("\nTotal Page Faults: %d\n", pageFaults);

    return 0;
}

